---
import Icon from '../Icon.astro';
import { negocio as cargarNegocio, encargos as cargarEncargos } from '../../lib/contenido';
const hayEncargos = (await cargarEncargos()).length > 0;
import { enlaceWhatsApp, pendiente } from '../../lib/formato';
const negocio = await cargarNegocio();
const wa = (mensaje?: string) => enlaceWhatsApp(negocio.whatsapp, mensaje);

const enlaces = [
  { href: '#catalogo', texto: 'Catálogo' },
  { href: '#tu-espacio', texto: '¿Entra?' },
  ...(hayEncargos ? [{ href: '#a-medida', texto: 'A medida' }] : []),
  { href: '#taller', texto: 'El taller' },
  { href: '#preguntas', texto: 'Preguntas' },
];
---
<header class="barra">
  <div class="envoltura barra__fila">
    <a class="barra__marca" href="#" aria-label={`${negocio.nombre}, ir al inicio`}>
      <span class="barra__sello" aria-hidden="true">m</span>
      <span class="barra__nombre">{negocio.nombre}</span>
    </a>
    <nav aria-label="Secciones">
      <ul>
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>
    <a class="barra__cta" href={wa()} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={17} />
      <span class="barra__cta-texto">Consultar</span>
    </a>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(244 239 231 / 0.9);
    backdrop-filter: blur(12px) saturate(1.1);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
    border-bottom: 1px solid var(--linea);
  }
  .barra__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .barra__marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    min-height: 2.75rem;
  }
  .barra__sello {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border: 1.5px solid var(--tinta);
    border-radius: 50%;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1;
    color: var(--madera);
    padding-bottom: 0.2rem;
  }
  .barra__nombre { font-family: var(--f-serif); font-size: 1.3125rem; letter-spacing: -0.01em; }
  nav ul { display: flex; gap: clamp(1.25rem, 2.4vw, 2.25rem); list-style: none; padding: 0; }
  nav a {
    display: inline-block;
    padding-block: 0.6rem;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--tinta-2);
    background: linear-gradient(var(--madera), var(--madera)) no-repeat left calc(100% - 0.35rem) / 0 1px;
    transition: color 0.3s var(--ease), background-size 0.45s var(--ease);
  }
  nav a:hover { color: var(--tinta); background-size: 100% 1px; }
  .barra__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--tinta);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .barra__cta:hover { background: var(--tinta); color: var(--crema); }

  @media (max-width: 960px) {
    nav { display: none; }
  }
  @media (max-width: 420px) {
    .barra__nombre { font-size: 1.125rem; }
    .barra__cta { padding-inline: 0.85rem; }
  }
</style>
