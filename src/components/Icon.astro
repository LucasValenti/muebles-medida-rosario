---
import * as lucide from 'lucide-static';
import { siWhatsapp, siInstagram, siFacebook } from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;

const brands: Record<string, { path: string }> = {
  whatsapp: siWhatsapp,
  instagram: siInstagram,
  facebook: siFacebook,
};

let svg: string;
if (brands[name]) {
  svg = `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false"><path d="${brands[name].path}"/></svg>`;
} else {
  const raw = (lucide as Record<string, string>)[name];
  svg = raw
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`)
    .replace(/stroke-width="2"/, 'stroke-width="1.75"')
    .replace('<svg', '<svg aria-hidden="true" focusable="false"');
}
---
<span class:list={['icon', cls]} set:html={svg} />

<style>
  .icon { display: inline-flex; flex: none; line-height: 0; }
</style>
