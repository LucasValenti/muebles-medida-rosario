---
import Icon from '../Icon.astro';
import { negocio, enlaceWhatsApp, pendiente } from '../../data/negocio';

const enlaces = [
  { href: '#trabajos', texto: 'Trabajos' },
  { href: '#taller', texto: 'El taller' },
  { href: '#proceso', texto: 'Cómo trabajamos' },
  { href: '#preguntas', texto: 'Preguntas' },
];
---
<header class="barra">
  <div class="envoltura barra__fila">
    <a class:list={['barra__marca', { pendiente: pendiente(negocio.nombre) }]} href="#contenido">{negocio.nombre}</a>
    <nav aria-label="Secciones">
      <ul class="barra__enlaces">
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>
    <a class="barra__cta" href="#presupuesto">
      Pedir presupuesto
    </a>
    <a class="barra__wa" href={enlaceWhatsApp()} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <Icon name="whatsapp" size={22} />
    </a>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(252 252 250 / 0.94);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--rayado);
  }
  .barra__fila {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4rem;
  }
  .barra__marca {
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-right: auto;
  }
  .barra__enlaces {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }
  .barra__enlaces a {
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 550;
    font-variation-settings: 'wdth' 90;
    color: var(--tinta-2);
    padding-block: 0.5rem;
    transition: color 0.2s;
  }
  .barra__enlaces a:hover { color: var(--tinta); text-decoration: underline; }
  .barra__cta {
    font-weight: 700;
    font-variation-settings: 'wdth' 85;
    font-size: 0.9375rem;
    text-decoration: none;
    padding: 0.6rem 1rem;
    border: 1.5px solid var(--tinta);
    border-radius: 3px;
    transition: background-color 0.2s, color 0.2s;
  }
  .barra__cta:hover { background: var(--tinta); color: var(--papel); }
  .barra__wa {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 3px;
    background: var(--carbon);
    color: var(--papel);
  }

  @media (max-width: 860px) {
    .barra nav { display: none; }
  }
  @media (max-width: 520px) {
    .barra__cta { display: none; }
    .barra__wa { display: grid; }
  }
</style>
