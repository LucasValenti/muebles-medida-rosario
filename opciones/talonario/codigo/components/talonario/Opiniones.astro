---
import { opiniones } from '../../data/contenido';
---
<section class="opiniones hoja" aria-labelledby="titulo-opiniones">
  <p class="hoja__marca envoltura" aria-hidden="true"><span class="rotulo">Original</span><span class="rotulo hoja__num">Hoja 5</span></p>
  <div class="envoltura">
    <h2 id="titulo-opiniones">Opiniones de clientes</h2>
    <ul class="opiniones__lista" role="list">
      {opiniones.map((o) => (
        <li class:list={['conformidad', { 'conformidad--pendiente': o.pendiente }]}>
          <blockquote>
            <p class="mano">“{o.texto}”</p>
          </blockquote>
          <div class="conformidad__firma">
            <span class="mano conformidad__nombre">{o.nombre}</span>
            <span class="rotulo">Firma y aclaración · {o.mueble}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .opiniones { padding-block: var(--seccion); }
  .opiniones__lista {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .conformidad {
    display: grid;
    gap: 1.75rem;
    align-content: space-between;
    padding-top: 1.25rem;
    border-top: 2px solid var(--tinta);
    background: repeating-linear-gradient(transparent 0 calc(2.5rem - 1px), var(--rayado) calc(2.5rem - 1px) 2.5rem);
    background-position: 0 1.25rem;
  }
  .conformidad blockquote p {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 2.5rem;
    max-width: 36ch;
  }
  .conformidad__firma {
    display: grid;
    gap: 0.4rem;
    width: min(100%, 18rem);
    background: var(--papel);
  }
  .conformidad__nombre {
    font-size: 1.375rem;
    line-height: 2rem;
    border-bottom: 1px solid var(--tinta);
  }
  .conformidad__firma .rotulo { color: var(--tinta-2); }
  .conformidad--pendiente blockquote p,
  .conformidad--pendiente .conformidad__nombre { color: var(--sello); }
  .conformidad--pendiente blockquote {
    outline: 1px dashed rgb(200 50 43 / 0.45);
    outline-offset: 6px;
  }
</style>
