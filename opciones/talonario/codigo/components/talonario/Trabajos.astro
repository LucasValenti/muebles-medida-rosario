---
import Icon from '../Icon.astro';
import { trabajos } from '../../data/contenido';
import { negocio, pendiente } from '../../data/negocio';

// Ritmo de la grilla: ancho+angosto, tres tercios, dos medios; se repite.
const ritmo = ['ancho', 'angosto', 'tercio', 'tercio', 'tercio', 'medio', 'medio'];
const anchos: Record<string, number> = { ancho: 7, angosto: 5, tercio: 4, medio: 6 };
// Si la última fila queda incompleta, el último trabajo se estira hasta completarla.
let fila = 0;
const spans = trabajos.map((_, i) => {
  const s = anchos[ritmo[i % ritmo.length]];
  fila = fila + s > 12 ? s : fila + s;
  return s;
});
if (fila < 12 && spans.length) spans[spans.length - 1] += 12 - fila;
const hayMuestras = trabajos.some((t) => t.muestra);
---
<section id="trabajos" class="trabajos hoja" aria-labelledby="titulo-trabajos">
  <p class="hoja__marca envoltura" aria-hidden="true"><span class="rotulo">Original</span><span class="rotulo hoja__num">Hoja 2</span></p>
  <div class="envoltura">
    <div class="trabajos__cabeza">
      <h2 id="titulo-trabajos">Cada centímetro de tu casa, aprovechado.</h2>
      <p>
        Placares, cocinas, mesas y muebles de living que salieron del taller. Cada uno se pensó para un espacio y una familia en particular.
      </p>
    </div>
    {hayMuestras && (
      <p class="trabajos__aviso">
        <span class="pendiente">Fotos de muestra</span> hasta sumar las fotos reales de los trabajos del taller.
      </p>
    )}

    <ul class="trabajos__grilla" role="list">
      {trabajos.map((t, i) => (
        <li class:list={['trabajo', `trabajo--${ritmo[i % ritmo.length]}`]} style={`--span: ${spans[i]}`}>
          <figure>
            <div class="trabajo__foto">
              <img src={t.foto} alt={t.alt} loading="lazy" decoding="async" width="1600" height="1067" />
              {t.muestra && <span class="trabajo__muestra">Muestra</span>}
            </div>
            <figcaption class="trabajo__talon">
              <span class="trabajo__folio num">N° {String(i + 1).padStart(3, '0')}</span>
              <h3>{t.mueble}</h3>
              <p><span class="trabajo__ambiente">{t.ambiente}.</span> {t.detalle}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <a class="trabajos__instagram" href={`https://instagram.com/${negocio.instagram}`} target="_blank" rel="noopener">
      <Icon name="instagram" size={22} />
      <span>Más trabajos en Instagram <span class:list={{ pendiente: pendiente(negocio.instagram) }}>@{negocio.instagram}</span></span>
      <Icon name="ArrowRight" size={20} class="trabajos__flecha" />
    </a>
  </div>
</section>

<style>
  .trabajos {
    padding-block: var(--seccion);
  }
  .trabajos__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .trabajos__cabeza h2 { max-width: 14ch; }
  .trabajos__cabeza p { color: var(--tinta-2); font-size: 1.125rem; line-height: 1.65; }
  .trabajos__aviso {
    margin-top: 1.75rem;
    font-size: var(--t-small);
    color: var(--tinta-2);
  }
  .trabajos__aviso .pendiente { color: var(--sello); font-weight: 650; padding-inline: 0.3rem; }

  .trabajos__grilla {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
  }
  .trabajo { grid-column: span var(--span); }
  .trabajo--ancho { --alto: clamp(20rem, 34vw, 31rem); }
  .trabajo--angosto { --alto: clamp(20rem, 34vw, 31rem); }
  .trabajo--tercio { --alto: clamp(15rem, 22vw, 20rem); }
  .trabajo--medio { --alto: clamp(17rem, 27vw, 24rem); }

  .trabajo figure { display: grid; height: 100%; grid-template-rows: auto 1fr; }
  .trabajo__foto {
    position: relative;
    height: var(--alto);
    overflow: hidden;
    background: var(--rayado);
  }
  .trabajo__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.9s var(--ease-salida);
  }
  .trabajo:hover .trabajo__foto img { scale: 1.035; }
  .trabajo__muestra {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: rgb(252 252 250 / 0.92);
    color: var(--sello);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
    border: 1px dashed rgb(200 50 43 / 0.55);
  }

  /* Talón debajo de cada foto: troquel arriba, folio rojo */
  .trabajo__talon {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: start;
    gap: 0.2rem 1rem;
    padding-top: 1.1rem;
    margin-top: 0.6rem;
  }
  .trabajo__talon::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: radial-gradient(circle, var(--rayado-fuerte) 1.6px, transparent 2px) 0 50% / 9px 6px repeat-x;
  }
  .trabajo__talon h3 { grid-column: 1; grid-row: 1; }
  .trabajo__folio {
    grid-column: 2;
    grid-row: 1;
    color: var(--sello);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    align-self: center;
  }
  .trabajo__talon p {
    grid-column: 1 / -1;
    color: var(--tinta-2);
    font-size: 0.96875rem;
    line-height: 1.55;
  }
  .trabajo__ambiente { color: var(--tinta); font-weight: 600; }

  .trabajos__instagram {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.25rem;
    border-top: 2px solid var(--tinta);
    border-bottom: 1px solid var(--rayado-fuerte);
    text-decoration: none;
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 80;
    line-height: 1.2;
  }
  .trabajos__instagram :global(.trabajos__flecha) {
    margin-left: auto;
    transition: translate 0.35s var(--ease-salida);
  }
  .trabajos__instagram:hover :global(.trabajos__flecha) { translate: 0.35rem 0; }

  @media (max-width: 900px) {
    .trabajos__cabeza { grid-template-columns: 1fr; }
    .trabajo--ancho, .trabajo--angosto, .trabajo--medio { grid-column: span 6 !important; --alto: clamp(16rem, 38vw, 22rem); }
    .trabajo--tercio { grid-column: span 6 !important; --alto: clamp(16rem, 38vw, 22rem); }
  }
  @media (max-width: 640px) {
    .trabajos__grilla {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-bottom: 0.75rem;
      scrollbar-width: thin;
    }
    .trabajo {
      flex: 0 0 82%;
      scroll-snap-align: start;
      scroll-margin-left: var(--gutter);
      --alto: 20rem !important;
    }
  }
</style>
