---
import Icon from '../Icon.astro';
import { preguntas } from '../../data/contenido';
---
<section id="preguntas" class="preguntas hoja" aria-labelledby="titulo-preguntas">
  <p class="hoja__marca envoltura" aria-hidden="true"><span class="rotulo">Observaciones</span><span class="rotulo hoja__num">Hoja 6</span></p>
  <div class="envoltura preguntas__grilla">
    <h2 id="titulo-preguntas">Preguntas frecuentes</h2>
    <div class="preguntas__lista">
      {preguntas.map((p, i) => (
        <details open={i === 0}>
          <summary>
            <span>{p.pregunta}</span>
            <Icon name="Plus" size={22} class="preguntas__icono" />
          </summary>
          <p>{p.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .preguntas { padding-block: var(--seccion); }
  .preguntas__grilla {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .preguntas h2 { max-width: 10ch; }
  .preguntas__lista { border-top: 2px solid var(--tinta); }
  details { border-bottom: 1px solid var(--rayado-fuerte); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 80;
    line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover span { text-decoration: underline; text-underline-offset: 0.2em; }
  summary :global(.preguntas__icono) { transition: rotate 0.35s var(--ease-salida); color: var(--carbon); }
  details[open] summary :global(.preguntas__icono) { rotate: 45deg; }
  details p {
    padding-bottom: 1.35rem;
    color: var(--tinta-2);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .preguntas__grilla { grid-template-columns: 1fr; }
  }
</style>
