---
import Icon from '../Icon.astro';
import Sello from './Sello.astro';
import { negocio, enlaceWhatsApp, pendiente } from '../../data/negocio';
import { ejemplosDePedido } from '../../data/contenido';

const hoy = new Date();
const fecha = hoy.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<section class="portada" aria-labelledby="titulo-portada">
  <div class="envoltura">
    <div class="membrete">
      <div class="membrete__marca">
        <p class:list={['membrete__nombre', { pendiente: pendiente(negocio.nombre) }]}>{negocio.nombre}</p>
        <p class="membrete__rubro">{negocio.rubro} · {negocio.ciudad}</p>
        <p class="membrete__datos">
          Taller: <span class:list={{ pendiente: pendiente(negocio.direccion) }}>{negocio.direccion}</span>, {negocio.ciudad}
          <br />Tel. <span class:list={['num', { pendiente: pendiente(negocio.telefonoVisible) }]}>{negocio.telefonoVisible}</span>
        </p>
      </div>

      <div class="membrete__x" aria-hidden="true">
        <span class="membrete__letra">X</span>
        <span class="membrete__leyenda">Documento no válido como factura</span>
      </div>

      <div class="membrete__folio">
        <p class="membrete__tipo">Presupuesto</p>
        <p class="membrete__numero num">
          N° 0001-<span class="rojo" data-folio>00000001</span>
        </p>
        <p class="campo campo--corto">
          <span class="rotulo">Fecha</span>
          <span class="mano campo__valor num" data-fecha>{fecha}</span>
        </p>
      </div>
    </div>

    <div class="cuerpo">
      <div class="cuerpo__texto">
        <p class="campo">
          <span class="rotulo">Señor/es</span>
          <span class="mano campo__valor escrito" style="--largo: 3; --demora: 0.2s">Vos</span>
        </p>

        <h1 id="titulo-portada">Muebles hechos a medida, con oficio.</h1>
        <p class="bajada">
          Diseñamos y fabricamos placares, cocinas, mesas y muebles de living pensados para tu espacio, con la calidez de la madera y la precisión del taller.
        </p>

        <table class="detalle">
          <caption class="solo-lector">Ejemplos de pedidos</caption>
          <thead>
            <tr>
              <th scope="col" class="rotulo">Cant.</th>
              <th scope="col" class="rotulo">Descripción</th>
              <th scope="col" class="rotulo detalle__importe">Importe</th>
            </tr>
          </thead>
          <tbody>
            {ejemplosDePedido.map((pedido, i) => (
              <tr>
                <td class="mano num"><span class="escrito" style={`--largo: 1; --demora: ${0.9 + i * 0.75}s`}>1</span></td>
                <td class="mano"><span class="escrito" style={`--largo: ${pedido.length}; --demora: ${1 + i * 0.75}s`}>{pedido}</span></td>
                <td class="mano detalle__importe"><span class="escrito" style={`--largo: 10; --demora: ${1.35 + i * 0.75}s`}>a presupuestar</span></td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="acciones">
          <a class="talon" href={enlaceWhatsApp()} target="_blank" rel="noopener">
            <span class="talon__talonario"><Icon name="whatsapp" size={22} /></span>
            <span class="talon__texto">Pedí tu presupuesto por WhatsApp</span>
          </a>
          <a class="boton-linea" href={`tel:${negocio.telefono}`}>
            <Icon name="Phone" size={20} /> Llamar ahora
          </a>
        </div>
        <p class="aclaracion">Sin compromiso. Mandanos una foto o captura y las medidas del lugar.</p>
      </div>

      <figure class="adjunto">
        <img
          src="/fotos/muestra/cocina.jpg"
          alt="Cocina completa con bajo mesada y alacenas en melamina símil madera"
          width="1600"
          height="2400"
          fetchpriority="high"
        />
        <figcaption>
          <span class="rotulo">Adjunto</span> Cocina completa
          <span class="pendiente adjunto__muestra">foto de muestra</span>
        </figcaption>
        <Sello class="adjunto__sello" arriba="HECHO EN TALLER" abajo="ROSARIO · SANTA FE" centro="A MEDIDA" />
      </figure>
    </div>
  </div>
</section>

<script>
  const hoy = new Date();
  const fecha = hoy.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  document.querySelectorAll('[data-fecha]').forEach((el) => (el.textContent = fecha));
  const folio = String(hoy.getFullYear() % 100).padStart(2, '0') + String(hoy.getMonth() + 1).padStart(2, '0') + String(hoy.getDate()).padStart(2, '0');
  document.querySelectorAll('[data-folio]').forEach((el) => (el.textContent = folio.padStart(8, '0')));
</script>

<style>
  .portada {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem);
    background:
      linear-gradient(var(--papel), var(--papel)) padding-box;
  }

  /* Membrete impreso */
  .membrete {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--tinta);
  }
  .membrete__nombre {
    font-weight: 800;
    font-variation-settings: 'wdth' 72;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    width: fit-content;
  }
  .membrete__rubro {
    font-weight: 600;
    font-variation-settings: 'wdth' 88;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .membrete__datos {
    margin-top: 0.5rem;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--tinta-2);
  }
  .membrete__x {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    width: 7rem;
    text-align: center;
  }
  .membrete__letra {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 2px solid var(--tinta);
    font-size: 2.5rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 80;
    line-height: 1;
  }
  .membrete__leyenda {
    font-size: 0.625rem;
    line-height: 1.25;
    letter-spacing: 0.02em;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
  .membrete__folio { justify-self: end; text-align: right; display: grid; gap: 0.4rem; justify-items: end; }
  .membrete__tipo {
    font-weight: 850;
    font-variation-settings: 'wdth' 64;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
    line-height: 0.9;
  }
  .membrete__numero {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .rojo { color: var(--sello); font-weight: 700; }

  /* Campo de formulario impreso con su renglón */
  .campo {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border-bottom: 1px solid var(--rayado-fuerte);
    padding-bottom: 0.15rem;
    max-width: none;
  }
  .campo .rotulo { flex: none; color: var(--tinta-2); }
  .campo__valor { font-size: 1.375rem; line-height: 2.25rem; }
  .campo--corto { min-width: 11rem; }

  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .cuerpo__texto > .campo + .campo { margin-top: 0.5rem; }

  h1 {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    font-size: clamp(2.5rem, 1.25rem + 4.2vw, 5rem);
    line-height: 0.92;
    font-weight: 820;
    font-variation-settings: 'wdth' 64;
    letter-spacing: -0.025em;
    max-width: 15ch;
  }
  .bajada {
    margin-top: 1rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--tinta-2);
    max-width: 50ch;
  }

  /* Detalle del comprobante */
  .detalle {
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
    border-top: 2px solid var(--tinta);
    border-bottom: 2px solid var(--tinta);
  }
  .detalle th {
    text-align: left;
    padding: 0.6rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--tinta);
    color: var(--tinta-2);
  }
  .detalle td {
    padding: 0.2rem 0.75rem 0.1rem 0;
    border-bottom: 1px solid var(--rayado);
    font-size: 1.25rem;
    line-height: 2rem;
    vertical-align: top;
  }
  .detalle tr:last-child td { border-bottom: 0; }
  .detalle th:first-child, .detalle td:first-child { width: 3.5rem; }
  .detalle__importe { text-align: right !important; white-space: nowrap; padding-right: 0 !important; }
  .detalle td.detalle__importe { font-size: 1.0625rem; }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .aclaracion {
    margin-top: 0.85rem;
    font-size: var(--t-small);
    color: var(--tinta-2);
  }

  /* Foto adjunta a la hoja */
  .adjunto {
    position: relative;
    align-self: start;
    margin-top: 0.5rem;
    padding: 0.75rem 0.75rem 0;
    background: #fff;
    box-shadow: 0 1px 2px rgb(28 28 31 / 0.12), 0 18px 40px -22px rgb(28 28 31 / 0.45);
    rotate: 1.25deg;
  }
  .adjunto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .adjunto figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    padding: 0.7rem 0.1rem 0.8rem;
    font-size: var(--t-small);
    line-height: 1.3;
    font-weight: 600;
  }
  .adjunto figcaption .rotulo { color: var(--tinta-2); }
  .adjunto__muestra {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0 0.35rem;
    color: var(--sello);
  }
  .adjunto :global(.adjunto__sello) {
    position: absolute;
    width: clamp(8.5rem, 13vw, 11rem);
    left: clamp(-5rem, -5vw, -2rem);
    bottom: 1.25rem;
    rotate: -14deg;
    opacity: 0.95;
    z-index: 3;
    mix-blend-mode: multiply;
  }

  /* Escritura en carbónico: el contenido ya está en la página; solo se revela */
  @media (prefers-reduced-motion: no-preference) {
    .escrito {
      display: inline-block;
      animation: escribir calc(var(--largo) * 28ms + 180ms) steps(var(--largo), end) var(--demora) both;
    }
    .adjunto :global(.adjunto__sello) {
      animation: sellar 0.5s var(--ease-salida) 3.2s both;
    }
  }
  @keyframes escribir {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes sellar {
    from { opacity: 0; scale: 1.5; filter: blur(2px); }
    60% { opacity: 0.95; scale: 0.96; filter: blur(0); }
    to { opacity: 0.95; scale: 1; }
  }

  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; }
    .adjunto { max-width: 26rem; margin-inline: auto 0.5rem; margin-top: 1rem; }
    .adjunto :global(.adjunto__sello) { left: -2rem; }
  }
  @media (max-width: 640px) {
    .membrete { grid-template-columns: 1fr auto; }
    .membrete__x { display: none; }
    .membrete__tipo { font-size: 1.5rem; }
    .membrete__numero { font-size: 0.9375rem; }
    .membrete__datos { display: none; }
    .campo--corto { min-width: 0; }
    .detalle td { font-size: 1.125rem; line-height: 1.6rem; padding-block: 0.45rem; vertical-align: top; }
    .detalle th:first-child, .detalle td:first-child { width: 2.25rem; }
    .detalle__importe { display: none; }
    .acciones .talon { width: 100%; }
    .adjunto { margin-inline: 1.5rem 0.25rem; }
  }
</style>
